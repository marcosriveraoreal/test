# --- RabbitMQ ---
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=notifications-exchange
RABBITMQ_ROUTING_KEY=notification.it

# --- Hub de monitorización ---
HUB_EXCHANGE=atalaya-monitor-exchange
HUB_ROUTING_KEY=monitor.events
HEARTBEAT_INTERVAL_SECONDS=60

# --- Alertas de email ---
ALERT_ENABLED=true
ALERT_DESTINATARIOS=
ALERT_CC=
ALERT_MODELO_CORREO=56
ALERT_CUENTA_CORREO=1
ALERT_AUTH_TOKEN=

# --- Cooldowns (segundos) ---
ALERT_COOLDOWN_DIED_SECONDS=300
ALERT_COOLDOWN_OOM_SECONDS=300
ALERT_COOLDOWN_UNHEALTHY_SECONDS=600
ALERT_COOLDOWN_CRASHLOOP_SECONDS=1800

# --- Crashloop ---
ALERT_CRASHLOOP_THRESHOLD=3
ALERT_CRASHLOOP_WINDOW_SECONDS=300

# --- Contenedores a ignorar ---
ALERT_IGNORE_CONTAINERS=

# --- API de logs (acceso desde el hub) ---
AGENT_API_PORT=9092
AGENT_API_TOKEN=
# URL accesible desde el hub, ej: http://192.168.1.10:9092
AGENT_API_URL=

# --- Monitor de logs ---
# Activar detección de patrones en logs de contenedores
LOG_MONITOR_ENABLED=false
# Patrones regex separados por coma (case-sensitive)
LOG_MONITOR_PATTERNS=ERROR,CRITICAL,Exception,Traceback,FATAL,PANIC
# Segundos de espera entre alertas del mismo contenedor
LOG_MONITOR_COOLDOWN_SECONDS=300
# Longitud máxima de la línea incluida en el detalle de la alerta
LOG_MONITOR_MAX_LINE_LENGTH=200

# --- General ---
LOG_LEVEL=INFO
HOST_NAME=nombre-del-servidor
TZ=Europe/Madrid
