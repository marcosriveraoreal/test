# --- RabbitMQ ---
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=notifications-exchange
RABBITMQ_ROUTING_KEY=notification.it

# --- Hub de monitorización ---
HUB_EXCHANGE=atalaya-monitor-exchange
HUB_ROUTING_KEY=monitor.events
HEARTBEAT_INTERVAL_SECONDS=60

# --- Alertas de email ---
ALERT_ENABLED=true
ALERT_DESTINATARIOS=
ALERT_CC=
ALERT_MODELO_CORREO=56
ALERT_CUENTA_CORREO=1
ALERT_AUTH_TOKEN=

# --- Cooldowns (segundos) ---
ALERT_COOLDOWN_DIED_SECONDS=300
ALERT_COOLDOWN_OOM_SECONDS=300
ALERT_COOLDOWN_UNHEALTHY_SECONDS=600
ALERT_COOLDOWN_CRASHLOOP_SECONDS=1800

# --- Crashloop ---
ALERT_CRASHLOOP_THRESHOLD=3
ALERT_CRASHLOOP_WINDOW_SECONDS=300

# --- Contenedores a ignorar ---
ALERT_IGNORE_CONTAINERS=

# --- General ---
LOG_LEVEL=INFO
HOST_NAME=nombre-del-servidor
TZ=Europe/Madrid
